{
  "name": "MORGAN",
  "short_name": "MORGAN",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b171e",
  "theme_color": "#0b171e",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            ".pdf",
            ".txt",
            ".md",
            ".csv",
            ".json",
            ".docx",
            ".pptx",
            ".xlsx",
            ".xls",
            "application/pdf",
            "text/plain",
            "text/markdown",
            "text/csv",
            "application/json"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "text/plain": [
          ".txt"
        ],
        "text/markdown": [
          ".md"
        ],
        "text/csv": [
          ".csv"
        ],
        "application/json": [
          ".json"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [
          ".pptx"
        ],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ]
      },
      "launch_type": "multiple-clients"
    }
  ],
  "description": "MORGAN \u2014 your personal AI system with voice, live web search, memory, and an offline backup brain. Built by Ghashiyat.",
  "orientation": "portrait",
  "categories": [
    "productivity",
    "utilities"
  ],
  "screenshots": [
    {
      "src": "/screenshot-narrow.png",
      "sizes": "540x1170",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "MORGAN on mobile"
    },
    {
      "src": "/screenshot-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "MORGAN on desktop"
    }
  ]
}